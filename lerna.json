{
    "packages": ["./", "packages/*"],
    "version": "3.0.1",
    "command": {
        "publish": {
            "forcePublish": true
        },
        "version": {
            "conventionalCommits": true,
            "message": "chore(release): %v",
            "push": false,
            "changelogPreset": {
                "name": "conventionalcommits",
                "compareUrlFormat": "{{host}}/{{owner}}/{{repository}}/compare/{{previousTag}}...{{currentTag}}",
                "commitUrlFormat": "{{host}}/{{owner}}/{{repository}}/commit/{{hash}}"
            }
        }
    }
}
