{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Website-specific: no emit (vite builds), not a referenced project,
        // and transpiled per-file by vite/oxc so isolatedModules must hold.
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": ["src", "buildSrc", "vite.config.ts"]
}
